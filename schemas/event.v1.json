{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddds.event.v1",
  "title": "DDDS sensor event v1",
  "description": "The message every sensor node publishes when it detects something (IF-03).",
  "type": "object",
  "required": ["schema", "node_id", "type", "ts_utc", "class", "confidence"],
  "properties": {
    "schema":      { "const": "ddds.event.v1", "description": "Which version of this format the event uses" },
    "node_id":     { "type": "string", "description": "Which sensor sent it, e.g. cv-01 or rf-01" },
    "type":        { "type": "string", "description": "Kind of sensor: camera, remote_id, or a future type" },
    "ts_utc":      { "type": "string", "format": "date-time", "description": "When it was detected (UTC)" },
    "class":       { "type": "string", "description": "What was detected, e.g. drone, bird, DJI" },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1, "description": "How sure the sensor is, 0 to 1" },
    "bearing_deg": { "type": "number", "minimum": 0, "maximum": 360, "description": "Direction from the camera, in degrees" },
    "lat":         { "type": "number", "minimum": -90, "maximum": 90 },
    "lon":         { "type": "number", "minimum": -180, "maximum": 180 },
    "alt":         { "type": "number", "description": "Altitude in metres" },
    "rid_serial":  { "type": "string", "description": "Remote ID serial number" }
  },
  "allOf": [
    {
      "if":   { "properties": { "type": { "const": "camera" } } },
      "then": { "required": ["bearing_deg"] }
    },
    {
      "if":   { "properties": { "type": { "const": "remote_id" } } },
      "then": { "required": ["lat", "lon", "alt", "rid_serial"] }
    }
  ]
}
